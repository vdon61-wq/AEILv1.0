{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vdon61-wq.github.io/AEILv1.0/protocol/aeil-emotional-event.schema.json",
  "title": "AEIL v1.1 Emotional Event",
  "description": "Normative atomic unit of AEIL Emotional Memory (MEMORY.md section 2). Generalises the 'Universal AEIL Data Object' shown non-normatively in index.html by adding provenance, per-inference confidence, lifecycle, subject isolation, and retention.",
  "type": "object",
  "required": ["event_id", "occurred_at", "recorded_at", "subject_ref", "scope", "source", "modality", "observation", "confidence", "purpose", "legal_basis", "retention", "schema_version"],
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },

    "occurred_at": { "type": "string", "format": "date-time" },
    "recorded_at": { "type": "string", "format": "date-time" },

    "subject_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Pseudonymous subject handle. MUST NOT be a raw identifier where avoidable. Retrieval is hard-scoped to this value (MEMORY.md section 2 constraint 3)."
    },
    "scope": { "enum": ["turn", "session", "relationship", "account"] },

    "source": {
      "type": "object",
      "required": ["component"],
      "additionalProperties": true,
      "properties": {
        "component": { "type": "string", "description": "Which subsystem produced this record" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "model_version": { "type": "string" },
        "memory_provider": { "type": "string", "description": "MPI implementation name, if external" }
      }
    },
    "modality": { "enum": ["text", "voice", "behavioral", "explicit_statement", "tool_event"] },

    "observation": {
      "type": "string",
      "minLength": 1,
      "description": "Observable evidence ONLY - what was literally present in the input. Structurally separate from 'inference' per MEMORY.md section 2 constraint 1 (PRINCIPLES P3, TAXONOMY IN-02)."
    },
    "inference": {
      "type": "string",
      "description": "Interpretation derived from the observation. May be absent when no inference was made."
    },
    "inferred_state": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "confidence"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "basis": { "enum": ["user_stated", "contextual_signal", "hypothesis", "system_observation", "unavailable_information"] },
          "derived_from": { "type": "array", "items": { "type": "string" }, "description": "event_ids this inference depends on" }
        }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "status": { "enum": ["user_stated", "hypothesis"], "default": "hypothesis", "description": "MEMORY.md section 2: cause MUST be marked hypothesis unless user-stated." }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "description": { "type": "string" },
        "resolved": { "type": "boolean" },
        "action_taken": { "type": "string" },
        "evaluated_at": { "type": "string", "format": "date-time" }
      }
    },

    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Event-level confidence. MUST be produced by the inference step. Hard-coded or randomly generated values are non-conformant (MEMORY.md section 2 constraint 2)."
    },
    "confidence_method": {
      "type": "string",
      "description": "How confidence was produced (calibrated model score, judge agreement, rule-based). Required for reproducibility (P10)."
    },
    "uncertainty": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Named unknowns, per SAFETY.md section 3."
    },

    "supersedes": { "type": "array", "items": { "type": "string" } },
    "contradicts": { "type": "array", "items": { "type": "string" } },
    "superseded_by": { "type": "string" },
    "status": { "enum": ["active", "superseded", "contradicted", "forgotten", "expired"], "default": "active" },

    "safety_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "manipulation_risk", "coercive_language", "conflict_escalation", "false_empathy",
          "anthropomorphic_deception", "unauthorized_profiling", "privacy_overreach",
          "failure_to_escalate", "failure_to_deescalate", "excessive_certainty",
          "inappropriate_persistence", "boundary_violation", "unsafe_autonomous_action",
          "vulnerability_disclosed", "self_harm_risk", "minor_involved"
        ]
      },
      "description": "Mirrors TAXONOMY.md section C risk themes."
    },

    "purpose": {
      "type": "string",
      "minLength": 3,
      "description": "Why this is retained at all. SAFETY.md section 5 / SPECIFICATION section 10."
    },
    "legal_basis": {
      "enum": ["consent", "contract", "legal_obligation", "vital_interests", "public_interest", "legitimate_interests", "medical_safety"],
      "description": "GDPR Art. 6/9-style basis. 'medical_safety' is the only basis that can support workplace/education emotion inference under EU AI Act Art. 5(1)(f) - see RESPONSIBLE_USE.md PU-1/PU-2."
    },
    "retention": {
      "type": "object",
      "required": ["rule"],
      "additionalProperties": false,
      "properties": {
        "rule": { "enum": ["ttl", "retain_until", "session_only", "explicit_release"] },
        "ttl": { "type": "string", "description": "ISO-8601 duration, e.g. 'P30D'" },
        "retain_until": { "type": "string", "format": "date-time" },
        "delete_on_request": { "type": "boolean", "default": true },
        "propagate_to_derived_state": { "type": "boolean", "default": true, "description": "MEMORY.md section 5: deletion MUST trigger recomputation of dependent states (SU-3)." }
      }
    },
    "sensitive_category": {
      "type": "boolean",
      "default": false,
      "description": "True if this record could reveal a GDPR Art. 9 special category. If true, RESPONSIBLE_USE.md PU-8 applies."
    },
    "subject_informed": {
      "type": "boolean",
      "description": "Was the person told this signal is captured? RESPONSIBLE_USE.md section 3(1)."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "retention": { "properties": { "rule": { "const": "ttl" } } } } },
      "then": { "properties": { "retention": { "required": ["ttl"] } } }
    },
    {
      "if": { "properties": { "retention": { "properties": { "rule": { "const": "retain_until" } } } } },
      "then": { "properties": { "retention": { "required": ["retain_until"] } } }
    },
    {
      "if": { "properties": { "status": { "const": "superseded" } } },
      "then": { "required": ["superseded_by"] }
    }
  ]
}
